<Window x:Class="SharePermissionsTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows 共享与 NTFS 权限查询工具 (C# 高能版 v4.0)" Height="750" Width="1050" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- 页签 1：按用户/组查询 -->
            <TabItem Header="按用户/组查询权限">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="本机/域名:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Name="txtDomain" Width="140" IsReadOnly="True" Background="#F0F0F0" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <Button Name="btnSearchByUser" Content=" 开始查询权限 " Padding="12,5" Margin="0,0,10,0" FontWeight="Bold" Click="BtnSearchByUser_Click"/>
                        <Button Name="btnCancelUser" Content=" 停止 " Padding="10,5" Margin="0,0,10,0" IsEnabled="False" Click="BtnCancel_Click"/>
                        <Button Name="btnExportUser" Content=" 导出结果 (CSV) " Padding="10,5" Click="BtnExportUser_Click"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="1. 选择目标用户或组 (可多选)" Grid.Column="0" Margin="0,0,5,0" Padding="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ListBox Name="lstTargetUsers" Grid.Column="0" Height="110"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Button Content="全选" Width="50" Margin="0,0,0,4" Click="BtnSelectAllUsers_Click"/>
                                    <Button Content="全不选" Width="50" Margin="0,0,0,4" Click="BtnClearAllUsers_Click"/>
                                    <Button Content="刷新" Width="50" Click="BtnRefreshUsers_Click"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="2. 选择目标共享文件夹 (默认全选)" Grid.Column="1" Margin="5,0,0,0" Padding="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ListBox Name="lstUserShares" Grid.Column="0" Height="110"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Button Content="全选" Width="50" Margin="0,0,0,4" Click="BtnSelectAllUserShares_Click"/>
                                    <Button Content="全不选" Width="50" Click="BtnClearAllUserShares_Click"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <DataGrid Name="dgUserResults" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="匹配账号" Binding="{Binding Account}" Width="160"/>
                            <DataGridTextColumn Header="共享根名称" Binding="{Binding ShareName}" Width="110"/>
                            <DataGridTextColumn Header="实际文件夹路径" Binding="{Binding Path}" Width="280"/>
                            <DataGridTextColumn Header="权限来源" Binding="{Binding PermType}" Width="110"/>
                            <DataGridTextColumn Header="访问控制" Binding="{Binding AccessControlType}" Width="80"/>
                            <DataGridTextColumn Header="详细权限" Binding="{Binding Rights}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 页签 2：按共享文件夹查询 -->
            <TabItem Header="按共享文件夹查询用户">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <Button Name="btnSearchByShare" Content=" 查询共享的用户 " Padding="12,5" Margin="0,0,10,0" FontWeight="Bold" Click="BtnSearchByShare_Click"/>
                        <Button Name="btnCancelShare" Content=" 停止 " Padding="10,5" Margin="0,0,10,0" IsEnabled="False" Click="BtnCancel_Click"/>
                        <Button Name="btnExportShare" Content=" 导出结果 (CSV) " Padding="10,5" Click="BtnExportShare_Click"/>
                    </StackPanel>

                    <GroupBox Header="选择目标共享文件夹 (可多选)" Grid.Row="1" Margin="0,0,0,10" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ListBox Name="lstShareTabShares" Grid.Column="0" Height="100"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Button Content="全选" Width="60" Margin="0,0,0,4" Click="BtnSelectAllShareTabShares_Click"/>
                                <Button Content="全不选" Width="60" Margin="0,0,0,4" Click="BtnClearAllShareTabShares_Click"/>
                                <Button Content="刷新列表" Width="60" Click="BtnRefreshShares_Click"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <DataGrid Name="dgShareResults" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="文件夹路径" Binding="{Binding Path}" Width="280"/>
                            <DataGridTextColumn Header="用户/组 账号" Binding="{Binding Account}" Width="240"/>
                            <DataGridTextColumn Header="权限来源" Binding="{Binding PermType}" Width="110"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding AccessControlType}" Width="80"/>
                            <DataGridTextColumn Header="授予的权限" Binding="{Binding Rights}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 底部状态栏与进度更新 -->
        <StatusBar Grid.Row="1" Margin="0,5,0,0">
            <StatusBarItem>
                <TextBlock Name="lblStatus" Text="就绪" Foreground="Blue"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
