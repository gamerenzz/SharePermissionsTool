<Window x:Class="SharePermissionsTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows 共享与 NTFS 权限企业级审计工具 (C# 精简高能版 v6.1)" Height="780" Width="1180" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- 页签 1：按用户/组查询 -->
            <TabItem Header="按用户/组查询权限">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="本机/域名:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Name="txtDomain" Width="110" IsReadOnly="True" Background="#F0F0F0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        
                        <CheckBox Name="chkShowSystemTab1" Content="显示系统账号" VerticalAlignment="Center" Margin="0,0,12,0"
                                  ToolTip="勾选后将显示 SYSTEM, Administrators 等系统账号"/>
                        
                        <CheckBox Name="chkIncludeInheritedTab1" Content="包含纯继承子目录" VerticalAlignment="Center" Margin="0,0,12,0"
                                  ToolTip="取消勾选时，仅展示【共享根目录】与【单独设置了直接权限的子目录】，大幅去重"/>

                        <CheckBox Name="chkCalcEffectiveTab1" Content="计算 SMB∩NTFS 交集" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"
                                  ToolTip="开启后自动计算共享权限与NTFS权限的最终交集"/>

                        <Button Name="btnSearchByUser" Content=" 开始查询权限 " Padding="10,5" Margin="0,0,8,0" FontWeight="Bold" Click="BtnSearchByUser_Click"/>
                        <Button Name="btnCancelUser" Content=" 停止 " Padding="8,5" Margin="0,0,8,0" IsEnabled="False" Click="BtnCancel_Click"/>
                        <Button Name="btnExportUserCsv" Content=" 导出 CSV " Padding="8,5" Margin="0,0,8,0" Click="BtnExportUserCsv_Click"/>
                        <Button Name="btnExportUserHtml" Content=" 📊 HTML 报告 " Padding="8,5" Background="#E1F5FE" FontWeight="Bold" Click="BtnExportUserHtml_Click"/>
                    </StackPanel>

                    <!-- 配置区 -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="1. 选择目标用户或组 (多选)" Grid.Column="0" Margin="0,0,5,0" Padding="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ListBox Name="lstTargetUsers" Grid.Column="0" Height="100"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Button Content="全选" Width="50" Margin="0,0,0,4" Click="BtnSelectAllUsers_Click"/>
                                    <Button Content="全不选" Width="50" Margin="0,0,0,4" Click="BtnClearAllUsers_Click"/>
                                    <Button Content="刷新" Width="50" Click="BtnRefreshUsers_Click"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="2. 选择目标共享文件夹 (默认全选)" Grid.Column="1" Margin="5,0,0,0" Padding="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ListBox Name="lstUserShares" Grid.Column="0" Height="100"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Button Content="全选" Width="50" Margin="0,0,0,4" Click="BtnSelectAllUserShares_Click"/>
                                    <Button Content="全不选" Width="50" Click="BtnClearAllUserShares_Click"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- 表格结果 -->
                    <DataGrid Name="dgUserResults" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="All" SelectionMode="Extended" SelectionUnit="FullRow"
                              ClipboardCopyMode="ExcludeHeader" MouseDoubleClick="DataGrid_MouseDoubleClick"
                              PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📁 复制文件夹路径" Click="ContextMenu_CopyPath_Click"/>
                                <MenuItem Header="🚀 在资源管理器中打开" Click="ContextMenu_OpenFolder_Click"/>
                                <Separator/>
                                <MenuItem Header="📋 复制整行数据" Click="ContextMenu_CopyRow_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="安全风险" Binding="{Binding RiskBadge}" Width="80"/>
                            <DataGridTextColumn Header="匹配账号" Binding="{Binding Account}" Width="170"/>
                            <DataGridTextColumn Header="共享根" Binding="{Binding ShareName}" Width="90"/>
                            <DataGridTextColumn Header="实际文件夹路径" Binding="{Binding Path}" Width="240"/>
                            <DataGridTextColumn Header="来源" Binding="{Binding PermType}" Width="90"/>
                            <DataGridTextColumn Header="继承" Binding="{Binding InheritanceStatus}" Width="65"/>
                            <DataGridTextColumn Header="控制" Binding="{Binding AccessControlType}" Width="65"/>
                            
                            <DataGridTextColumn Header="读取" Binding="{Binding ReadStr}" Width="45"/>
                            <DataGridTextColumn Header="写入" Binding="{Binding WriteStr}" Width="45"/>
                            <DataGridTextColumn Header="修改" Binding="{Binding ModifyStr}" Width="45"/>
                            <DataGridTextColumn Header="删除" Binding="{Binding DeleteStr}" Width="45"/>
                            <DataGridTextColumn Header="全控" Binding="{Binding FullControlStr}" Width="45"/>

                            <DataGridTextColumn Header="有效权限/风险描述" Binding="{Binding RightsDescription}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 页签 2：按共享文件夹查询 -->
            <TabItem Header="按共享文件夹查询用户">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <CheckBox Name="chkShowSystemTab2" Content="显示系统账号" VerticalAlignment="Center" Margin="0,0,12,0"
                                  ToolTip="勾选后将显示 SYSTEM, Administrators 等系统账号"/>
                        
                        <CheckBox Name="chkIncludeInheritedTab2" Content="包含纯继承子目录" VerticalAlignment="Center" Margin="0,0,12,0"
                                  ToolTip="取消勾选时，仅展示【共享根目录】与【单独设置了直接权限的子目录】，大幅去重"/>

                        <CheckBox Name="chkCalcEffectiveTab2" Content="计算 SMB∩NTFS 交集" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"
                                  ToolTip="开启后自动计算共享权限与NTFS权限的最终交集"/>

                        <Button Name="btnSearchByShare" Content=" 查询共享的用户 " Padding="10,5" Margin="0,0,8,0" FontWeight="Bold" Click="BtnSearchByShare_Click"/>
                        <Button Name="btnCancelShare" Content=" 停止 " Padding="8,5" Margin="0,0,8,0" IsEnabled="False" Click="BtnCancel_Click"/>
                        <Button Name="btnExportShareCsv" Content=" 导出 CSV " Padding="8,5" Margin="0,0,8,0" Click="BtnExportShareCsv_Click"/>
                        <Button Name="btnExportShareHtml" Content=" 📊 HTML 报告 " Padding="8,5" Background="#E1F5FE" FontWeight="Bold" Click="BtnExportShareHtml_Click"/>
                    </StackPanel>

                    <GroupBox Header="选择目标共享文件夹 (多选)" Grid.Row="1" Margin="0,0,0,10" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ListBox Name="lstShareTabShares" Grid.Column="0" Height="100"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Button Content="全选" Width="60" Margin="0,0,0,4" Click="BtnSelectAllShareTabShares_Click"/>
                                <Button Content="全不选" Width="60" Margin="0,0,0,4" Click="BtnClearAllShareTabShares_Click"/>
                                <Button Content="刷新列表" Width="60" Click="BtnRefreshShares_Click"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <DataGrid Name="dgShareResults" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="All" SelectionMode="Extended" SelectionUnit="FullRow"
                              ClipboardCopyMode="ExcludeHeader" MouseDoubleClick="DataGrid_MouseDoubleClick"
                              PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📁 复制文件夹路径" Click="ContextMenu_CopyPath_Click"/>
                                <MenuItem Header="🚀 在资源管理器中打开" Click="ContextMenu_OpenFolder_Click"/>
                                <Separator/>
                                <MenuItem Header="📋 复制整行数据" Click="ContextMenu_CopyRow_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="安全风险" Binding="{Binding RiskBadge}" Width="80"/>
                            <DataGridTextColumn Header="文件夹路径" Binding="{Binding Path}" Width="260"/>
                            <DataGridTextColumn Header="用户/组 账号" Binding="{Binding Account}" Width="190"/>
                            <DataGridTextColumn Header="来源" Binding="{Binding PermType}" Width="90"/>
                            <DataGridTextColumn Header="继承" Binding="{Binding InheritanceStatus}" Width="65"/>
                            <DataGridTextColumn Header="控制" Binding="{Binding AccessControlType}" Width="65"/>

                            <DataGridTextColumn Header="读取" Binding="{Binding ReadStr}" Width="45"/>
                            <DataGridTextColumn Header="写入" Binding="{Binding WriteStr}" Width="45"/>
                            <DataGridTextColumn Header="修改" Binding="{Binding ModifyStr}" Width="45"/>
                            <DataGridTextColumn Header="删除" Binding="{Binding DeleteStr}" Width="45"/>
                            <DataGridTextColumn Header="全控" Binding="{Binding FullControlStr}" Width="45"/>

                            <DataGridTextColumn Header="有效权限/风险描述" Binding="{Binding RightsDescription}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 底部状态栏 -->
        <StatusBar Grid.Row="1" Margin="0,5,0,0">
            <StatusBarItem>
                <TextBlock Name="lblStatus" Text="就绪 (C# v6.1 精简高能版)" Foreground="Blue"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
